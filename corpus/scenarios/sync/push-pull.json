{
  "description": "Two devices sharing a branch through a remote (a result's remote_head is the head seen before it moved, and a first transfer carries the root commit too): a push that creates the remote branch, a pull that creates it on the other device, a push from there, a fast-forwarding pull back, and syncs with nothing to do.",
  "clock": 1700004000.5,
  "steps": [
    { "op": "remote", "as": "origin", "id": "origin" },
    { "op": "store", "as": "laptop" },
    { "op": "open", "as": "desk" },
    { "op": "open", "as": "lap", "store": "laptop" },
    { "op": "worktree", "repo": "desk", "as": "d", "branch": "main", "create": true },
    { "op": "set", "wt": "d", "key": "note", "value": "from the desk" },
    { "op": "commit", "wt": "d", "expect": { "commit": "$d1" } },
    { "op": "push", "remote": "origin", "branch": "main", "expect": { "status": "created", "local_head": "$d1", "remote_head": null, "transferred": 2 } },
    { "op": "remote_refs", "remote": "origin", "expect": { "main": "$d1" } },
    { "op": "pull", "store": "laptop", "remote": "origin", "branch": "main", "expect": { "status": "created", "local_head": "$d1", "transferred": 2 } },
    { "op": "worktree", "repo": "lap", "as": "l", "branch": "main" },
    { "op": "get", "from": "l", "key": "note", "expect": "from the desk" },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "l", "key": "note", "value": "edited on the laptop" },
    { "op": "commit", "wt": "l", "expect": { "commit": "$l1" } },
    { "op": "push", "store": "laptop", "remote": "origin", "branch": "main", "expect": { "status": "pushed", "local_head": "$l1", "remote_head": "$d1", "transferred": 1 } },
    { "op": "pull", "remote": "origin", "branch": "main", "expect": { "status": "fast-forwarded", "local_head": "$l1", "transferred": 1 } },
    { "op": "refresh", "wt": "d" },
    { "op": "get", "from": "d", "key": "note", "expect": "edited on the laptop" },
    { "op": "sync", "remote": "origin", "branch": "main", "expect": { "status": "up-to-date", "pull": { "status": "up-to-date" }, "push": { "status": "up-to-date", "transferred": 0 } } },
    { "op": "sync", "store": "laptop", "remote": "origin", "branch": "main", "expect": { "status": "up-to-date" } }
  ],
  "final": {
