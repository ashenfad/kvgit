{
  "description": "Two devices that both commit before syncing: the second push and pull report the branch diverged and move no ref; merging the fetched remote head locally and syncing again settles it.",
  "clock": 1700004100.25,
  "steps": [
    { "op": "remote", "as": "origin", "id": "origin" },
    { "op": "store", "as": "laptop" },
    { "op": "open", "as": "desk" },
    { "op": "open", "as": "lap", "store": "laptop" },
    { "op": "worktree", "repo": "desk", "as": "d", "branch": "main", "create": true },
    { "op": "set", "wt": "d", "key": "shared", "value": "base" },
    { "op": "commit", "wt": "d", "expect": { "commit": "$base" } },
    { "op": "push", "remote": "origin", "branch": "main", "expect": { "status": "created" } },
    { "op": "pull", "store": "laptop", "remote": "origin", "branch": "main", "expect": { "status": "created" } },
    { "op": "worktree", "repo": "lap", "as": "l", "branch": "main" },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "d", "key": "desk", "value": "d" },
    { "op": "commit", "wt": "d", "expect": { "commit": "$d1" } },
    { "op": "set", "wt": "l", "key": "lap", "value": "l" },
    { "op": "commit", "wt": "l", "expect": { "commit": "$l1" } },
    { "op": "push", "remote": "origin", "branch": "main", "expect": { "status": "pushed", "local_head": "$d1", "remote_head": "$base" } },
    { "op": "push", "store": "laptop", "remote": "origin", "branch": "main", "expect": { "status": "diverged", "local_head": "$l1", "remote_head": "$d1" } },
    { "op": "pull", "store": "laptop", "remote": "origin", "branch": "main", "expect": { "status": "diverged", "local_head": "$l1", "remote_head": "$d1" } },
    { "op": "clock", "advance": 1 },
    { "op": "merge", "wt": "l", "commit": "$d1", "expect": { "strategy": "three_way", "commit": "$m1", "carried_keys": ["desk"] } },
    { "op": "sync", "store": "laptop", "remote": "origin", "branch": "main", "expect": { "status": "pushed", "push": { "local_head": "$m1", "remote_head": "$d1" } } },
    { "op": "pull", "remote": "origin", "branch": "main", "expect": { "status": "fast-forwarded", "local_head": "$m1" } },
    { "op": "refresh", "wt": "d" },
    { "op": "keys", "from": "d", "expect": ["desk", "lap", "shared"] }
  ],
