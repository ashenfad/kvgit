    { "op": "merge_base", "repo": "r", "a": "$a1", "b": "$base", "expect": "$base" },
    { "op": "merge_base", "repo": "r", "a": "$root", "b": "$b1", "expect": "$root" },
    { "op": "merge_base", "repo": "r", "a": "$a1", "b": "$a1", "expect": "$a1" },
