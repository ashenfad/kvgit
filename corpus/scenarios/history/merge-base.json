    { "op": "clock", "advance": 1 },
    { "op": "merge", "wt": "a", "commit": "$b1", "expect": { "strategy": "three_way", "commit": "$am" } },
    { "op": "merge", "wt": "b", "commit": "$a1", "expect": { "strategy": "three_way", "commit": "$bm" } },
    { "op": "merge_base", "repo": "r", "a": "$am", "b": "$bm", "expect": "$b1" },
    { "op": "merge_base", "repo": "r", "a": "$bm", "b": "$am", "expect": "$b1" },
    { "op": "clock", "advance": 1 },
    { "op": "merge", "wt": "a", "branch": "b", "expect": { "strategy": "three_way", "commit": "$final" } },
    { "op": "get_commit", "repo": "r", "commit": "$final", "expect": { "parents": ["$am", "$bm"] } },
    { "op": "keys", "from": "a", "expect": ["k", "x", "y"] },
    { "op": "log", "repo": "r", "branch": "a", "expect": ["$final", "$am", "$bm", "$a1", "$b1", "$base", "$root"] }
  ],
