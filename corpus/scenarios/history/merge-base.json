  "description": "Merge bases: of a commit and its ancestor, of forked tips, of anything and the root, and of a criss-cross where two commits are both lowest common ancestors and the one with the smaller hash is the base.",
  "clock": 1700000600.5,
  "steps": [
    { "op": "open", "as": "r" },
    { "op": "worktree", "repo": "r", "as": "a", "branch": "a", "create": true },
    { "op": "set", "wt": "a", "key": "k", "value": "0" },
    { "op": "commit", "wt": "a", "expect": { "commit": "$base" } },
    { "op": "branch_create", "repo": "r", "name": "b", "at": "$base" },
    { "op": "worktree", "repo": "r", "as": "b", "branch": "b" },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "a", "key": "x", "value": "a1" },
