{
  "description": "Commits with on_moved=raise: one that lands as a fast-forward, one refused because the branch moved, even with nothing to commit, and the refresh that recovers. A commit with nothing pending is a no-op at the worktree's own head. Partial commits of named keys, discard and reset.",
  "clock": 1700000800.375,
  "steps": [
    { "op": "open", "as": "alice" },
    { "op": "open", "as": "bob" },
    { "op": "worktree", "repo": "alice", "as": "a", "branch": "main", "create": true },
    { "op": "worktree", "repo": "bob", "as": "b", "branch": "main" },
    { "op": "set", "wt": "a", "key": "x", "value": "1" },
    { "op": "commit", "wt": "a", "on_moved": "raise", "expect": { "strategy": "fast_forward", "commit": "$a1" } },
    { "op": "commit", "wt": "b", "on_moved": "raise", "expect": { "error": "BranchMovedError" } },
    { "op": "commit", "wt": "b", "expect": { "strategy": "no_op", "commit": "$root" } },
    { "op": "head", "wt": "b", "expect": "$root" },
    { "op": "refresh", "wt": "b" },
    { "op": "head", "wt": "b", "expect": "$a1" },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "a", "key": "y", "value": "2" },
    { "op": "commit", "wt": "a", "expect": { "commit": "$a2" } },
    { "op": "set", "wt": "b", "key": "z", "value": "3" },
    { "op": "commit", "wt": "b", "on_moved": "raise", "expect": { "error": "BranchMovedError" } },
    { "op": "get", "from": "b", "key": "z", "expect": "3" },
    { "op": "refresh", "wt": "b" },
    { "op": "get", "from": "b", "key": "z", "expect": null },
    { "op": "head", "wt": "b", "expect": "$a2" },
    { "op": "set", "wt": "b", "key": "z", "value": "3" },
    { "op": "set", "wt": "b", "key": "later", "value": "4" },
    { "op": "commit", "wt": "b", "on_moved": "raise", "keys": ["z"], "expect": { "strategy": "fast_forward", "commit": "$b1" } },
    { "op": "get", "from": "b", "key": "later", "expect": "4" },
    { "op": "snapshot", "repo": "bob", "as": "s", "commit": "$b1" },
    { "op": "keys", "from": "s", "expect": ["x", "y", "z"] },
    { "op": "discard", "wt": "b" },
    { "op": "get", "from": "b", "key": "later", "expect": null },
    { "op": "reset", "wt": "b", "commit": "$a1" },
    { "op": "branches", "repo": "bob", "expect": { "main": "$a1" } },
    { "op": "keys", "from": "b", "expect": ["x"] }
  ],
