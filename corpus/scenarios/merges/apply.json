{
  "description": "Cherry-pick, revert and apply: a picked change lands as one single-parent commit, keeping changes made here; picking it again is a no-op; reverting undoes it; a picked change that collides raises unless a rule resolves it.",
  "clock": 1700000500.125,
  "steps": [
    { "op": "open", "as": "r" },
    { "op": "worktree", "repo": "r", "as": "main", "branch": "main", "create": true },
    { "op": "set", "wt": "main", "key": "a", "value": "1" },
    { "op": "set", "wt": "main", "key": "b", "value": "1" },
    { "op": "commit", "wt": "main", "expect": { "commit": "$base" } },
    { "op": "branch_create", "repo": "r", "name": "topic", "at": "$base" },
    { "op": "worktree", "repo": "r", "as": "topic", "branch": "topic" },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "topic", "key": "a", "value": "2" },
    { "op": "set", "wt": "topic", "key": "c", "value": "new" },
    { "op": "commit", "wt": "topic", "expect": { "commit": "$t1" } },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "main", "key": "b", "value": "here" },
    { "op": "commit", "wt": "main", "expect": { "commit": "$m1" } },
    { "op": "clock", "advance": 1 },
    { "op": "cherry_pick", "wt": "main", "commit": "$t1", "info": { "pick": "t1" },
      "expect": { "strategy": "apply", "commit": "$p1", "carried_keys": ["a", "c"] } },
    { "op": "get_commit", "repo": "r", "commit": "$p1", "expect": { "parents": ["$m1"], "info": { "pick": "t1" } } },
    { "op": "keys", "from": "main", "expect": ["a", "b", "c"] },
    { "op": "get", "from": "main", "key": "b", "expect": "here" },
    { "op": "cherry_pick", "wt": "main", "commit": "$t1", "expect": { "strategy": "no_op", "commit": "$p1" } },
    { "op": "clock", "advance": 1 },
    { "op": "revert", "wt": "main", "commit": "$p1", "expect": { "strategy": "apply", "commit": "$r1" } },
    { "op": "get", "from": "main", "key": "a", "expect": "1" },
    { "op": "get", "from": "main", "key": "c", "expect": null },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "main", "key": "a", "value": "main's own" },
    { "op": "commit", "wt": "main", "expect": { "commit": "$m2" } },
    { "op": "apply", "wt": "main", "base": "$base", "target": "$t1", "expect": { "error": "MergeConflict", "keys": ["a"] } },
    { "op": "apply", "wt": "main", "base": "$base", "target": "$t1", "merge_fns": { "a": "concat" },
      "expect": { "strategy": "apply", "auto_merged_keys": ["a"], "carried_keys": ["c"] } },
    { "op": "get", "from": "main", "key": "a", "expect": "2+main's own" },
    { "op": "apply", "wt": "main", "base": "$base", "target": "nope", "expect": { "error": "UnknownCommitError" } }
  ],
