{
  "description": "Merging a branch back after both sides moved: a key both added joined by a merge function, a prefix handed to theirs by policy, a clean key carried. Then a conflict raised and abandoned, a no-op merge, a fast-forward, a forced merge commit, and a merge from a commit and a tag.",
  "clock": 1700000400.5,
  "steps": [
    { "op": "open", "as": "r", "merge_prefixes": { "cfg/": "theirs" } },
    { "op": "worktree", "repo": "r", "as": "main", "branch": "main", "create": true },
    { "op": "set", "wt": "main", "key": "shared", "value": "base" },
    { "op": "set", "wt": "main", "key": "cfg/mode", "value": "base" },
    { "op": "commit", "wt": "main", "expect": { "commit": "$base" } },
    { "op": "branch_create", "repo": "r", "name": "side", "at": "$base" },
    { "op": "worktree", "repo": "r", "as": "side", "branch": "side" },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "side", "key": "n", "value": "side" },
    { "op": "set", "wt": "side", "key": "cfg/mode", "value": "side" },
    { "op": "set", "wt": "side", "key": "only-side", "value": "s" },
    { "op": "commit", "wt": "side", "info": { "on": "side" }, "expect": { "commit": "$s1" } },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "main", "key": "n", "value": "main" },
    { "op": "set", "wt": "main", "key": "cfg/mode", "value": "main" },
    { "op": "commit", "wt": "main", "expect": { "commit": "$m1" } },
    { "op": "merge_base", "repo": "r", "a": "$m1", "b": "$s1", "expect": "$base" },
    { "op": "clock", "advance": 1 },
    { "op": "merge", "wt": "main", "branch": "side", "info": { "merge": "side" }, "merge_fns": { "n": "concat" },
      "expect": { "merged": true, "strategy": "three_way", "commit": "$merge1", "auto_merged_keys": ["cfg/mode", "n"], "carried_keys": ["only-side"] } },
    { "op": "get", "from": "main", "key": "n", "expect": "side+main" },
    { "op": "get", "from": "main", "key": "cfg/mode", "expect": "side" },
    { "op": "get_commit", "repo": "r", "commit": "$merge1", "expect": { "parents": ["$m1", "$s1"], "info": { "merge": "side" } } },
    { "op": "diff", "repo": "r", "a": "$m1", "b": "$merge1", "expect": { "added": ["only-side"], "removed": [], "modified": ["cfg/mode", "n"] } },
    { "op": "merge", "wt": "main", "branch": "side", "expect": { "strategy": "no_op", "commit": "$merge1" } },

    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "side", "key": "shared", "value": "side edit" },
    { "op": "commit", "wt": "side", "expect": { "commit": "$s2" } },
    { "op": "set", "wt": "main", "key": "shared", "value": "main edit" },
    { "op": "commit", "wt": "main", "expect": { "commit": "$m2" } },
    { "op": "merge", "wt": "main", "branch": "side", "expect": { "error": "MergeConflict", "keys": ["shared"] } },
    { "op": "merge", "wt": "main", "branch": "side", "on_conflict": "abandon", "expect": { "merged": false, "commit": null } },
    { "op": "head", "wt": "main", "expect": "$m2" },
    { "op": "merge", "wt": "main", "commit": "$s2", "merge_fns": { "shared": "text_strict" }, "expect": { "error": "MergeConflict", "keys": ["shared"] } },
    { "op": "merge", "wt": "main", "commit": "$s2", "default_merge": "pick_ours", "expect": { "strategy": "three_way", "auto_merged_keys": ["shared"], "commit": "$merge2" } },
    { "op": "get", "from": "main", "key": "shared", "expect": "main edit" },

    { "op": "clock", "advance": 1 },
    { "op": "branch_create", "repo": "r", "name": "ff", "at": "$merge2" },
    { "op": "worktree", "repo": "r", "as": "ff", "branch": "ff" },
    { "op": "set", "wt": "ff", "key": "ff-key", "value": "ff" },
    { "op": "commit", "wt": "ff", "expect": { "commit": "$f1" } },
    { "op": "merge", "wt": "main", "branch": "ff", "expect": { "strategy": "fast_forward", "commit": "$f1", "carried_keys": ["ff-key"] } },
    { "op": "set", "wt": "ff", "key": "ff-key", "value": "ff2" },
    { "op": "commit", "wt": "ff", "expect": { "commit": "$f2" } },
    { "op": "tag_create", "repo": "r", "name": "release", "commit": "$f2" },
    { "op": "merge", "wt": "main", "tag": "release", "fast_forward": false, "info": { "forced": true },
      "expect": { "strategy": "three_way", "commit": "$merge3", "carried_keys": ["ff-key"] } },
    { "op": "get_commit", "repo": "r", "commit": "$merge3", "expect": { "parents": ["$f1", "$f2"], "info": { "forced": true } } },
    { "op": "log", "repo": "r", "branch": "main", "first_parent": true, "limit": 4, "expect": ["$merge3", "$f1", "$merge2", "$m2"] },
    { "op": "set", "wt": "main", "key": "pending", "value": "p" },
    { "op": "merge", "wt": "main", "branch": "side", "expect": { "error": "invalid" } }
  ],
