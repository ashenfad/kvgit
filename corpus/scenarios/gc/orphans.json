{
  "description": "Unreachable commits under gc: kept while younger than min_age, taken once older, while every commit a branch or tag reaches stays. Values only an orphan held go with it; values a live commit shares stay.",
  "clock": 1700001000.5,
  "steps": [
    { "op": "open", "as": "r" },
    { "op": "worktree", "repo": "r", "as": "main", "branch": "main", "create": true },
    { "op": "set", "wt": "main", "key": "shared", "value": "kept" },
    { "op": "commit", "wt": "main", "expect": { "commit": "$m1" } },
    { "op": "branch_create", "repo": "r", "name": "scratch", "at": "$m1" },
    { "op": "worktree", "repo": "r", "as": "s", "branch": "scratch" },
    { "op": "clock", "advance": 10 },
    { "op": "set", "wt": "s", "key": "only-scratch", "value": "dropped" },
    { "op": "commit", "wt": "s", "expect": { "commit": "$s1" } },
    { "op": "clock", "advance": 10 },
    { "op": "set", "wt": "s", "key": "only-scratch", "value": "dropped too" },
    { "op": "commit", "wt": "s", "expect": { "commit": "$s2" } },
    { "op": "branch_delete", "repo": "r", "name": "scratch" },
    { "op": "clock", "advance": 10 },
    { "op": "gc", "repo": "r", "min_age": 15, "expect": 1 },
    { "op": "snapshot", "repo": "r", "as": "gone", "commit": "$s1", "expect": { "error": "UnknownCommitError" } },
    { "op": "snapshot", "repo": "r", "as": "young", "commit": "$s2" },
    { "op": "get", "from": "young", "key": "only-scratch", "expect": "dropped too" },
    { "op": "clock", "advance": 3600 },
    { "op": "gc", "repo": "r", "expect": 1 },
    { "op": "snapshot", "repo": "r", "as": "gone2", "commit": "$s2", "expect": { "error": "UnknownCommitError" } },
    { "op": "gc", "repo": "r", "expect": 0 },
    { "op": "get", "from": "main", "key": "shared", "expect": "kept" },
    { "op": "log", "repo": "r", "branch": "main", "expect": ["$m1", "$root"] }
  ],
