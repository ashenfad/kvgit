  "description": "A commit held after its batch lands while another writer moves the branch: its publish loses the compare-and-swap, so it merges onto the new tip; with on_moved=raise it is refused instead, and nothing it wrote stays reachable.",
  "clock": 1700003100.25,
  "steps": [
    { "op": "open", "as": "alice" },
    { "op": "open", "as": "bob" },
    { "op": "worktree", "repo": "alice", "as": "a", "branch": "main", "create": true },
    { "op": "worktree", "repo": "bob", "as": "b", "branch": "main" },
    { "op": "set", "wt": "a", "key": "x", "value": "alice" },
    { "op": "start", "job": "alice", "pause": "publish", "step": { "op": "commit", "wt": "a" } },
    { "op": "set", "wt": "b", "key": "y", "value": "bob" },
    { "op": "commit", "wt": "b", "expect": { "strategy": "fast_forward", "commit": "$b1" } },
    { "op": "resume", "job": "alice", "expect": { "strategy": "three_way", "commit": "$m1", "carried_keys": ["y"] } },
    { "op": "get_commit", "repo": "bob", "commit": "$m1", "expect": { "parents": ["$b1", "$a1"] } },
    { "op": "keys", "from": "a", "expect": ["x", "y"] },
    { "op": "clock", "advance": 1 },
    { "op": "set", "wt": "a", "key": "x", "value": "alice again" },
    { "op": "start", "job": "alice2", "pause": "publish", "step": { "op": "commit", "wt": "a", "on_moved": "raise" } },
    { "op": "set", "wt": "b", "key": "y", "value": "bob again" },
    { "op": "commit", "wt": "b", "expect": { "strategy": "three_way", "commit": "$b2" } },
    { "op": "resume", "job": "alice2", "expect": { "error": "BranchMovedError" } },
    { "op": "get", "from": "a", "key": "x", "expect": "alice again" },
    { "op": "branches", "repo": "bob", "expect": { "main": "$b2" } },
    { "op": "clock", "advance": 7200 },
    { "op": "gc", "repo": "bob", "expect": "$swept" }
  ],
