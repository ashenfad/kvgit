  "description": "Two repositories commit on the same stale head. The second lands as a three-way merge carrying the first's change; with on_moved=raise it is refused instead and its change stays pending.",
  "clock": 1700000100.5,
  "steps": [
    { "op": "open", "as": "alice" },
    { "op": "open", "as": "bob" },
    { "op": "worktree", "repo": "alice", "as": "a", "branch": "main", "create": true },
    { "op": "worktree", "repo": "bob", "as": "b", "branch": "main" },
    { "op": "set", "wt": "a", "key": "x", "value": "from alice" },
    { "op": "commit", "wt": "a", "expect": {"strategy": "fast_forward", "commit": "$a1"} },
    { "op": "clock", "advance": 1.5 },
    { "op": "set", "wt": "b", "key": "y", "value": "from bob" },
    { "op": "commit", "wt": "b", "expect": {"strategy": "three_way", "commit": "$m1", "carried_keys": ["x"], "auto_merged_keys": []} },
    { "op": "get_commit", "repo": "alice", "commit": "$m1", "expect": {"parents": ["$a1", "$b1"]} },
    { "op": "keys", "from": "b", "expect": ["x", "y"] },
    { "op": "clock", "advance": 2 },
    { "op": "set", "wt": "a", "key": "z", "value": "too late" },
    { "op": "commit", "wt": "a", "on_moved": "raise", "expect": {"error": "BranchMovedError"} },
    { "op": "get", "from": "a", "key": "z", "expect": "too late" },
    { "op": "branches", "repo": "alice", "expect": {"main": "$m1"} }
  ],
