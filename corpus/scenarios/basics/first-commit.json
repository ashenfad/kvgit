{
  "description": "A new branch, one commit of a text and a binary value, read back from the worktree, a second repository and a snapshot.",
  "clock": 1700000000.25,
  "steps": [
    { "op": "open", "as": "alice" },
    { "op": "worktree", "repo": "alice", "as": "w", "branch": "main", "create": true },
    { "op": "head", "wt": "w", "expect": "$root" },
    { "op": "set", "wt": "w", "key": "greeting", "value": "hello" },
    { "op": "set", "wt": "w", "key": "blob", "value": {"b64": "AP+AAQ=="} },
    { "op": "get", "from": "w", "key": "greeting", "expect": "hello" },
    { "op": "commit", "wt": "w", "info": {"message": "first"}, "expect": {"merged": true, "strategy": "fast_forward", "commit": "$c1"} },
    { "op": "head", "wt": "w", "expect": "$c1" },
    { "op": "open", "as": "bob" },
    { "op": "worktree", "repo": "bob", "as": "b", "branch": "main" },
    { "op": "get", "from": "b", "key": "blob", "expect": {"b64": "AP+AAQ=="} },
    { "op": "keys", "from": "b", "expect": ["blob", "greeting"] },
    { "op": "snapshot", "repo": "bob", "as": "s", "commit": "$c1" },
    { "op": "get", "from": "s", "key": "greeting", "expect": "hello" },
    { "op": "get", "from": "s", "key": "missing", "expect": null },
    { "op": "branches", "repo": "bob", "expect": {"main": "$c1"} },
    { "op": "get_commit", "repo": "bob", "commit": "$c1", "expect": {"parents": ["$root"], "time": 1700000000.25, "info": {"message": "first"}} },
    { "op": "log", "repo": "bob", "branch": "main", "expect": ["$c1", "$root"] }
  ],
